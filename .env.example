# OIDC broker configuration. Copy to .env and fill in the blanks.
#
# Values are read from .env, then .env.local, then the environment, with later
# sources taking precedence. Don't wrap values in quotes: `docker run
# --env-file` passes quotes through literally.

# --- Server ------------------------------------------------------------------

PORT=3000
# debug, info, warn or error.
APP_LOG_LEVEL=info

# --- OIDC --------------------------------------------------------------------

# The broker's public base URL, with no trailing slash. Each provider is an
# issuer at {APP_OIDC_ISSUER}/providers/{name}.
APP_OIDC_ISSUER=http://localhost:3000

# Applications allowed to use the broker, as a JSON array:
# [{"client_id":"my-app","client_secret":"...","redirect_uris":["https://my-app.example.com/callback"]}]
APP_OIDC_CLIENTS=

# Upstream OAuth providers, as a JSON array. Each needs name, client_id,
# client_secret and callback_url ({APP_OIDC_ISSUER}/auth/{name}/callback).
# type is twitter, github or google and defaults to name. Optional: auth_url,
# token_url, user_url, scopes, and prefix_subject (default true).
# [{"name":"github","client_id":"...","client_secret":"...","callback_url":"http://localhost:3000/auth/github/callback"}]
APP_PROVIDERS=

# --- Token signing key ---------------------------------------------------------

APP_KEY_ID=
# An RSA private key of at least 2048 bits, base64-encoded PEM:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 | tr -d '\n'
APP_KEY_PRIVATE_BASE64=
# Or a path to the PEM file instead.
APP_KEY_PRIVATE_PEM_PATH=

# While rotating keys, the previous key ID and its base64-encoded PEM (public
# or private) keep tokens signed with the old key valid until they expire.
APP_KEY_PREVIOUS_ID=
APP_KEY_PREVIOUS_BASE64=

# --- Sign-in cookie ----------------------------------------------------------

# At least 32 characters: openssl rand -base64 32
APP_SESSION_SECRET=
# Defaults to true when APP_OIDC_ISSUER is https.
APP_SESSION_SECURE_COOKIE=

# --- Client IP (rate limiting and logs) ----------------------------------------
# Leave all three empty when clients connect directly. Behind a reverse proxy,
# set either APP_CLIENT_IP_HEADER (optionally with APP_TRUSTED_PROXY_CIDRS),
# APP_TRUSTED_PROXY_CIDRS alone (walks X-Forwarded-For), or
# APP_TRUSTED_PROXY_COUNT.

APP_CLIENT_IP_HEADER=
APP_TRUSTED_PROXY_CIDRS=
APP_TRUSTED_PROXY_COUNT=

# --- Authorization code store ------------------------------------------------
# Codes are kept in memory unless Redis is enabled. Use Redis when running
# more than one broker instance.

APP_AUTH_CODE_REDIS_STORE_ENABLED=false
APP_AUTH_CODE_REDIS_STORE_PREFIX=authcode:

APP_REDIS_ENABLED=false
APP_REDIS_HOST=localhost
APP_REDIS_PORT=6379
# rediss (TLS, the default) or redis.
APP_REDIS_PROTO=rediss
APP_REDIS_USER=
APP_REDIS_PASS=
APP_REDIS_DB=0

# --- Debug pages (development only) --------------------------------------------
# /debug/login and /debug/callback walk through a sign-in. The debug client
# must be in APP_OIDC_CLIENTS with {APP_DEBUG_BASE_URL}/debug/callback as a
# redirect URI.

APP_DEBUG_ENABLED=false
APP_DEBUG_BASE_URL=
APP_DEBUG_CLIENT_ID=
APP_DEBUG_CLIENT_SECRET=

# Optionally test the broker as an Amazon Cognito identity provider.
APP_DEBUG_COGNITO_ENABLED=false
APP_DEBUG_COGNITO_DOMAIN=
APP_DEBUG_COGNITO_CLIENT_ID=
APP_DEBUG_COGNITO_CLIENT_SECRET=
